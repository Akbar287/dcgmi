    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:admin": "tsx prisma/seed-admin.ts",
    "instrument:import": "tsx scripts/import-pre-review.ts",
    "artifact:import-package": "tsx scripts/import-assessment-package.ts",
    "db:studio": "prisma studio",
    "check": "pnpm typecheck && pnpm schema:check && pnpm baseline:check && pnpm method:verify"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
